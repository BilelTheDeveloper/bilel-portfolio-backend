NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bilel
# Set to the exact number of trusted reverse proxies; Render typically uses 1.
TRUST_PROXY=1
# Optional production email notifications. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECEIVER_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional one-time administrator setup with node seed.js. Existing accounts are preserved.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key backed up. Losing/changing it makes existing authenticator secrets unreadable.
MFA_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://bilelthedev.website,https://www.bilelthedev.website,https://bilel-portfolio-frontend.vercel.app
# Only set for a deliberate offline authenticator reset; remove afterward.
CONFIRM_MFA_RESET=

# Only for a deliberate offline password recovery; remove afterward.
CONFIRM_ADMIN_RESET=
