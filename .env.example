NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bilel
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GATE_MASTER_KEY=replace-with-a-long-random-gate-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bilel.dev,https://bilelthedev.vercel.app
# Set to the exact number of trusted reverse proxies; Render typically uses 1.
TRUST_PROXY=1
# Optional production email notifications. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECEIVER_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional one-time administrator setup with node seed.js. Existing accounts are preserved.
ADMIN_EMAIL=
ADMIN_PASSWORD=
